# Required identity keys. Copy this file to .env.local (gitignored) and fill in.
# The environment wins; sentgraph-mcp fills the keys left unset from .env.local
# in THIS directory only -- parent directories are never searched, so the file
# has to live in the project itself. A project with neither keys in the
# environment nor its own .env.local refuses to start (guards against global
# installs); note that keys exported in your shell profile satisfy that check
# everywhere, which is exactly what the guard is meant to prevent.
ZEP_API_KEY=
ZEP_USER_ID=
SENTGRAPH_PROJECT_ID=

# Hooks: read/write frequently by default.
SENTGRAPH_INJECT_EVERY_PROMPT=true
SENTGRAPH_PROJECT_AUTOCAPTURE=true
SENTGRAPH_CAPTURE_TOOLS=false
SENTGRAPH_CONTEXT_TOKEN_BUDGET=2000
